<UserControl x:Class="KiWin.App.Views.BrowserPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <StackPanel VerticalAlignment="Center" MaxWidth="900">
            <TextBlock x:Name="TitleText" Style="{StaticResource PageTitle}"
                       HorizontalAlignment="Center" TextAlignment="Center" />
            <TextBlock x:Name="SubtitleText" Style="{StaticResource BodyText}"
                       Foreground="{StaticResource SecondaryTextBrush}"
                       HorizontalAlignment="Center" TextAlignment="Center"
                       TextWrapping="Wrap" MaxWidth="600" Margin="0,0,0,30" />
            <Border Height="1" Width="280" HorizontalAlignment="Center"
                    Background="{StaticResource BorderStrongBrush}" Margin="0,0,0,30" />
            <ItemsControl x:Name="BrowserGrid" HorizontalAlignment="Center">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource BrowserCard}" Margin="8"
                                Click="BrowserButton_Click"
                                Tag="{Binding PackageId}" ToolTip="{Binding Tooltip}"
                                AutomationProperties.Name="{Binding Name}">
                            <StackPanel VerticalAlignment="Center">
                                <Image Source="{Binding IconPath}" Width="56" Height="56"
                                       HorizontalAlignment="Center" Margin="0,0,0,14" />
                                <TextBlock Text="{Binding Name}" FontSize="14.5"
                                           FontWeight="SemiBold" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button x:Name="SkipButton" Style="{StaticResource TextButton}" Margin="0,18,0,0"
                    HorizontalAlignment="Center" Click="SkipButton_Click" />
        </StackPanel>
    </Grid>
</UserControl>