<UserControl x:Class="KiWin.App.Views.BrowserPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <StackPanel VerticalAlignment="Center" MaxWidth="880" Margin="32,24">
            <TextBlock x:Name="TitleText" Style="{StaticResource PageTitle}"
                       HorizontalAlignment="Center" TextAlignment="Center" />
            <TextBlock x:Name="SubtitleText" Style="{StaticResource BodyText}"
                       Foreground="{StaticResource SecondaryTextBrush}"
                       HorizontalAlignment="Center" TextAlignment="Center"
                       TextWrapping="Wrap" MaxWidth="620" Margin="0,0,0,28" />
            <ItemsControl x:Name="BrowserGrid" HorizontalAlignment="Center">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel HorizontalAlignment="Center" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource BrowserCard}" Margin="8"
                                Click="BrowserButton_Click"
                                Tag="{Binding PackageId}" ToolTip="{Binding Tooltip}"
                                AutomationProperties.Name="{Binding Name}">
                            <StackPanel VerticalAlignment="Center">
                                <Image Source="{Binding IconPath}" Width="52" Height="52"
                                       HorizontalAlignment="Center" Margin="0,0,0,14"
                                       RenderOptions.BitmapScalingMode="HighQuality" />
                                <TextBlock Text="{Binding Name}" FontSize="14.5"
                                           FontWeight="SemiBold" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button x:Name="SkipButton" Style="{StaticResource TextButton}" Margin="0,20,0,0"
                    HorizontalAlignment="Center" Click="SkipButton_Click" />
        </StackPanel>
    </Grid>
</UserControl>
