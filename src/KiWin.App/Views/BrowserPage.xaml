<UserControl x:Class="KiWin.App.Views.BrowserPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel VerticalAlignment="Center" MaxWidth="860">
        <TextBlock x:Name="TitleText" Style="{StaticResource PageTitle}"
                   HorizontalAlignment="Center" TextAlignment="Center" />
        <ItemsControl x:Name="BrowserGrid" HorizontalAlignment="Center">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button x:Name="BrowserButton" Width="150" Height="140" Margin="8"
                            Padding="10" Click="BrowserButton_Click"
                            Tag="{Binding PackageId}" ToolTip="{Binding Tooltip}">
                        <StackPanel VerticalAlignment="Center">
                            <Image Source="{Binding IconPath}" Width="56" Height="56"
                                   HorizontalAlignment="Center" Margin="0,0,0,10" />
                            <TextBlock Text="{Binding Name}" FontSize="15"
                                       FontWeight="SemiBold" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Button x:Name="SkipButton" Style="{StaticResource GhostButton}" Margin="0,20,0,0"
                HorizontalAlignment="Center" Click="SkipButton_Click" />
    </StackPanel>
</UserControl>
