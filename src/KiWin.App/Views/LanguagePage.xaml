<UserControl x:Class="KiWin.App.Views.LanguagePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Margin="0,20" MaxWidth="440" HorizontalAlignment="Center" VerticalAlignment="Center">
        <ListBox x:Name="LanguageList" MaxHeight="430" SelectionChanged="LanguageList_SelectionChanged">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding NativeName}" FontSize="15"
                                   VerticalAlignment="Center" />
                        <TextBlock x:Name="checkMark" Grid.Column="1" Text="✓" FontSize="15"
                                   FontWeight="Bold" Foreground="{StaticResource AccentBrush}"
                                   VerticalAlignment="Center" Visibility="Collapsed" />
                    </Grid>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                     Value="True">
                            <Setter TargetName="checkMark" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <Button x:Name="BackButton" Style="{StaticResource GhostButton}" Margin="0,18,0,0"
                HorizontalAlignment="Center" Click="BackButton_Click" />
    </StackPanel>
</UserControl>