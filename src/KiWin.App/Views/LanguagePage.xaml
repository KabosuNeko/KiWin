<UserControl x:Class="KiWin.App.Views.LanguagePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Margin="0,20" MaxWidth="420" HorizontalAlignment="Center" VerticalAlignment="Center">
        <ListBox x:Name="LanguageList" MaxHeight="420" SelectionChanged="LanguageList_SelectionChanged">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding NativeName}" FontSize="15" />
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <Button x:Name="BackButton" Style="{StaticResource GhostButton}" Margin="0,18,0,0"
                HorizontalAlignment="Center" Click="BackButton_Click" />
    </StackPanel>
</UserControl>
