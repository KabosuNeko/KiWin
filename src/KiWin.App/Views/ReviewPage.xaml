<UserControl x:Class="KiWin.App.Views.ReviewPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock x:Name="TitleText" Style="{StaticResource PageTitle}" />
            <TextBlock x:Name="GuidanceText" TextWrapping="Wrap" Margin="0,0,0,14"
                       Foreground="{StaticResource SecondaryTextBrush}" />
            <TextBlock x:Name="NoBrowserWarning" TextWrapping="Wrap" Margin="0,0,0,8"
                       Foreground="#F9E2AF" Visibility="Collapsed" />
            <TextBlock x:Name="NoInternetInfo" TextWrapping="Wrap" Margin="0,0,0,8"
                       Foreground="#F9E2AF" Visibility="Collapsed" />
            <TextBlock x:Name="NoUpdatesWarning" TextWrapping="Wrap" Margin="0,0,0,8"
                       Foreground="#F9E2AF" Visibility="Collapsed" />
            <TextBlock x:Name="EmptyText" TextWrapping="Wrap" Margin="0,0,0,8"
                       Foreground="{StaticResource SecondaryTextBrush}" Visibility="Collapsed" />
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
            <ComboBox x:Name="PresetCombo" Width="220" DisplayMemberPath="Name"
                      SelectionChanged="PresetCombo_SelectionChanged" />
        </StackPanel>

        <ListBox x:Name="ItemsList" Grid.Row="2"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="14" />
                            <TextBlock Text="{Binding Tooltip}" TextWrapping="Wrap" FontSize="11"
                                       Foreground="{StaticResource SecondaryTextBrush}" Margin="0,3,0,0" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="✕" Width="30" Height="30" Padding="0"
                                VerticalAlignment="Center" Click="RemoveItem_Click" Tag="{Binding Key}" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
            <Button x:Name="BackButton" Style="{StaticResource GhostButton}" Margin="0,0,10,0"
                    Click="BackButton_Click" />
            <Button x:Name="ResetButton" Style="{StaticResource GhostButton}" Margin="0,0,10,0"
                    Click="ResetButton_Click" />
            <Button x:Name="AdvancedButton" Style="{StaticResource GhostButton}" Margin="0,0,10,0"
                    Click="AdvancedButton_Click" />
            <Button x:Name="StartButton" Style="{StaticResource AccentButton}" MinWidth="180"
                    Click="StartButton_Click" />
        </StackPanel>
    </Grid>
</UserControl>
