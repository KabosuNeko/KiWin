<UserControl x:Class="KiWin.App.Views.ReviewPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="30,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock x:Name="TitleText" Style="{StaticResource PageTitle}" />
            <TextBlock x:Name="GuidanceText" Style="{StaticResource BodyText}"
                       Foreground="{StaticResource SecondaryTextBrush}"
                       TextWrapping="Wrap" Margin="0,0,0,14" />

            <Border x:Name="NoBrowserChip" Style="{StaticResource WarningChip}" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="⚠" FontSize="13" FontWeight="Bold"
                               Foreground="{StaticResource WarningBrush}" Margin="0,0,10,0"
                               VerticalAlignment="Center" />
                    <TextBlock x:Name="NoBrowserWarning" TextWrapping="Wrap"
                               Foreground="{StaticResource WarningBrush}" FontSize="12.5"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Border>
            <Border x:Name="NoInternetChip" Style="{StaticResource WarningChip}" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="⚠" FontSize="13" FontWeight="Bold"
                               Foreground="{StaticResource WarningBrush}" Margin="0,0,10,0"
                               VerticalAlignment="Center" />
                    <TextBlock x:Name="NoInternetInfo" TextWrapping="Wrap"
                               Foreground="{StaticResource WarningBrush}" FontSize="12.5"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Border>
            <Border x:Name="NoUpdatesChip" Style="{StaticResource WarningChip}" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="⚠" FontSize="13" FontWeight="Bold"
                               Foreground="{StaticResource WarningBrush}" Margin="0,0,10,0"
                               VerticalAlignment="Center" />
                    <TextBlock x:Name="NoUpdatesWarning" TextWrapping="Wrap"
                               Foreground="{StaticResource WarningBrush}" FontSize="12.5"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Border>
            <TextBlock x:Name="EmptyText" Style="{StaticResource MutedText}" TextWrapping="Wrap"
                       Margin="0,0,0,8" Visibility="Collapsed" />
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,6,0,14">
            <TextBlock x:Name="PresetLabel" FontSize="13" FontWeight="SemiBold"
                       Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center"
                       Margin="0,0,10,0" />
            <ComboBox x:Name="PresetCombo" Width="240"
                      ItemTemplate="{StaticResource PresetItemTemplate}"
                      SelectionChanged="PresetCombo_SelectionChanged">
            </ComboBox>
        </StackPanel>

        <ListBox x:Name="ItemsList" Grid.Row="2"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <CheckBox Grid.Column="0" IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                  Tag="{Binding Key}" VerticalAlignment="Center"
                                  Margin="0,0,14,0"
                                  AutomationProperties.Name="{Binding Text}"
                                  Checked="ToggleItem_Changed" Unchecked="ToggleItem_Changed" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="14"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Tooltip}" TextWrapping="Wrap" FontSize="12"
                                       Foreground="{StaticResource SecondaryTextBrush}" Margin="0,4,0,0" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center"
                    Margin="0,18,0,0">
            <Button x:Name="BackButton" Style="{StaticResource GhostButton}" Margin="0,0,12,0"
                    Click="BackButton_Click" />
            <Button x:Name="ResetButton" Style="{StaticResource GhostButton}" Margin="0,0,12,0"
                    Click="ResetButton_Click" />
            <Button x:Name="AdvancedButton" Style="{StaticResource GhostButton}" Margin="0,0,12,0"
                    Click="AdvancedButton_Click" />
            <Button x:Name="StartButton" Style="{StaticResource AccentButton}" MinWidth="200"
                    Click="StartButton_Click" />
        </StackPanel>
    </Grid>
</UserControl>