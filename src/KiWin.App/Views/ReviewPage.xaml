<UserControl x:Class="KiWin.App.Views.ReviewPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="30,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock x:Name="TitleText" Style="{StaticResource PageTitle}" />
            <TextBlock x:Name="GuidanceText" Style="{StaticResource BodyText}"
                       Foreground="{StaticResource SecondaryTextBrush}"
                       TextWrapping="Wrap" Margin="0,0,0,14" />

            <Border x:Name="NoBrowserChip" Style="{StaticResource WarningChip}" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="⚠" FontSize="13" FontWeight="Bold"
                               Foreground="{StaticResource WarningBrush}" Margin="0,0,10,0"
                               VerticalAlignment="Center" />
                    <TextBlock x:Name="NoBrowserWarning" TextWrapping="Wrap"
                               Foreground="{StaticResource WarningBrush}" FontSize="12.5"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Border>
            <Border x:Name="NoInternetChip" Style="{StaticResource WarningChip}" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="⚠" FontSize="13" FontWeight="Bold"
                               Foreground="{StaticResource WarningBrush}" Margin="0,0,10,0"
                               VerticalAlignment="Center" />
                    <TextBlock x:Name="NoInternetInfo" TextWrapping="Wrap"
                               Foreground="{StaticResource WarningBrush}" FontSize="12.5"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Border>
            <Border x:Name="NoUpdatesChip" Style="{StaticResource WarningChip}" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="⚠" FontSize="13" FontWeight="Bold"
                               Foreground="{StaticResource WarningBrush}" Margin="0,0,10,0"
                               VerticalAlignment="Center" />
                    <TextBlock x:Name="NoUpdatesWarning" TextWrapping="Wrap"
                               Foreground="{StaticResource WarningBrush}" FontSize="12.5"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Border>
            <TextBlock x:Name="EmptyText" Style="{StaticResource MutedText}" TextWrapping="Wrap"
                       Margin="0,0,0,8" Visibility="Collapsed" />
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,6,0,14">
            <TextBlock x:Name="PresetLabel" FontSize="13" FontWeight="SemiBold"
                       Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center"
                       Margin="0,0,10,0" />
            <ComboBox x:Name="PresetCombo" Width="240"
                      ItemTemplate="{StaticResource PresetItemTemplate}"
                      SelectionChanged="PresetCombo_SelectionChanged">
            </ComboBox>
        </StackPanel>

        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ListBox x:Name="ItemsList"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="14"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Tooltip}" TextWrapping="Wrap" FontSize="12"
                                           Foreground="{StaticResource SecondaryTextBrush}" Margin="0,4,0,0" />
                            </StackPanel>
                            <Button Grid.Column="1" Style="{StaticResource IconButton}" Width="32" Height="32"
                                    Content="✕" FontSize="13" VerticalAlignment="Center"
                                    Click="RemoveItem_Click" Tag="{Binding Key}"
                                    ToolTip="Remove" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    CornerRadius="12" Padding="14,12" Margin="0,14,0,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="ExtraTitle" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,8,0"
                                   VerticalAlignment="Center" />
                        <TextBlock x:Name="ExtraHint" FontSize="12"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <CheckBox x:Name="CompanionCheck" FontSize="13.5" Margin="0,0,24,0"
                                  Tag="prevent-device-companion-apps"
                                  Checked="ExtraOption_Changed" Unchecked="ExtraOption_Changed" />
                        <CheckBox x:Name="WpbtCheck" FontSize="13.5"
                                  Tag="wpbt"
                                  Checked="ExtraOption_Changed" Unchecked="ExtraOption_Changed" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center"
                    Margin="0,18,0,0">
            <Button x:Name="BackButton" Style="{StaticResource GhostButton}" Margin="0,0,12,0"
                    Click="BackButton_Click" />
            <Button x:Name="ResetButton" Style="{StaticResource GhostButton}" Margin="0,0,12,0"
                    Click="ResetButton_Click" />
            <Button x:Name="AdvancedButton" Style="{StaticResource GhostButton}" Margin="0,0,12,0"
                    Click="AdvancedButton_Click" />
            <Button x:Name="StartButton" Style="{StaticResource AccentButton}" MinWidth="200"
                    Click="StartButton_Click" />
        </StackPanel>
    </Grid>
</UserControl>