<UserControl x:Class="KiWin.App.Views.AdvancedPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="30,24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="28" />
            <ColumnDefinition Width="2*" />
        </Grid.ColumnDefinitions>

        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <TextBlock x:Name="TitleText" Style="{StaticResource PageTitle}" />
                <Border Style="{StaticResource WarningChip}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⚠" FontSize="13" FontWeight="Bold"
                                   Foreground="{StaticResource WarningBrush}" Margin="0,0,10,0"
                                   VerticalAlignment="Center" />
                        <TextBlock x:Name="WarningText" TextWrapping="Wrap"
                                   Foreground="{StaticResource WarningBrush}" FontSize="12.5"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
                <TextBlock x:Name="StepsLabel" Style="{StaticResource SectionTitle}" Margin="0,18,0,10" />
                <ItemsControl x:Name="StepsList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <CheckBox x:Name="StepCheck" Margin="0,0,0,12" FontSize="13.5"
                                      IsChecked="{Binding IsEnabled}" Content="{Binding Text}"
                                      ToolTip="{Binding Tooltip}" Checked="StepCheck_Changed"
                                      Unchecked="StepCheck_Changed" Tag="{Binding Key}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button x:Name="BackButton" Style="{StaticResource GhostButton}" Margin="0,20,0,0"
                        HorizontalAlignment="Left" Click="BackButton_Click" />
            </StackPanel>
        </ScrollViewer>

        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
            <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="16,14"
                    Effect="{StaticResource ShadowLevel1}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock x:Name="Win11Label" Style="{StaticResource SectionTitle}" Margin="0,0,0,8" />
                    <TextBox x:Name="Win11ArgsBox" Height="100" AcceptsReturn="True"
                             TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Hidden" />
                    <Button x:Name="SaveWin11Button" Style="{StaticResource AccentButton}" Margin="0,10,0,0"
                            HorizontalAlignment="Stretch" Click="SaveWin11_Click" />
                </StackPanel>
            </Border>

            <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="16,14"
                    Effect="{StaticResource ShadowLevel1}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock x:Name="WinUtilLabel" Style="{StaticResource SectionTitle}" Margin="0,0,0,8" />
                    <TextBox x:Name="WinUtilBox" Height="100" AcceptsReturn="True"
                             TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Hidden"
                             ToolTip="{Binding WinUtilTooltip}" />
                    <Button x:Name="SaveWinUtilButton" Style="{StaticResource AccentButton}" Margin="0,10,0,0"
                            HorizontalAlignment="Stretch" Click="SaveWinUtil_Click" />
                </StackPanel>
            </Border>

            <Button x:Name="ImportPlanButton" Style="{StaticResource GhostButton}" Margin="0,0,0,8"
                    HorizontalAlignment="Stretch" Click="ImportPlan_Click" />
            <Button x:Name="ImportWinutilButton" Style="{StaticResource GhostButton}" Margin="0,0,0,8"
                    HorizontalAlignment="Stretch" Click="ImportWinutil_Click" />
            <Button x:Name="ExportPlanButton" Style="{StaticResource GhostButton}" Margin="0,0,0,18"
                    HorizontalAlignment="Stretch" Click="ExportPlan_Click" />
            <Button x:Name="UndoPolicyButton" Style="{StaticResource DangerButton}" Margin="0,0,0,8"
                    HorizontalAlignment="Stretch" Click="UndoPolicy_Click" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>