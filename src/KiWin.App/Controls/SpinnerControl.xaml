<UserControl x:Class="KiWin.App.Controls.SpinnerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="72" Height="72">
    <Grid Width="72" Height="72">
        <Ellipse Width="60" Height="60"
                 Stroke="#313244" StrokeThickness="6"
                 HorizontalAlignment="Center" VerticalAlignment="Center" />
        <Ellipse Width="60" Height="60"
                 Stroke="#CBA6F7" StrokeThickness="6"
                 StrokeDashArray="1.0 1.5" StrokeDashCap="Round"
                 HorizontalAlignment="Center" VerticalAlignment="Center"
                 RenderTransformOrigin="0.5,0.5">
            <Ellipse.RenderTransform>
                <RotateTransform x:Name="Arc" Angle="0" />
            </Ellipse.RenderTransform>
        </Ellipse>
    </Grid>
</UserControl>