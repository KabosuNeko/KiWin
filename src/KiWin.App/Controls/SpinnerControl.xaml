<UserControl x:Class="KiWin.App.Controls.SpinnerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="64" Height="64">
    <Grid>
        <Grid.RenderTransform>
            <RotateTransform x:Name="Arc" />
        </Grid.RenderTransform>
        <Ellipse Width="52" Height="52" Stroke="#45475A" StrokeThickness="5" />
        <Ellipse Width="52" Height="52" Stroke="#89B4FA" StrokeThickness="5"
                 StrokeDashArray="0.85 1.15" StrokeDashCap="Round" />
    </Grid>
</UserControl>
