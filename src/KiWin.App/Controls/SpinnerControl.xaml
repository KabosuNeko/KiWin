<UserControl x:Class="KiWin.App.Controls.SpinnerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="72" Height="72">
    <Grid>
        <Grid.RenderTransform>
            <RotateTransform x:Name="Arc" />
        </Grid.RenderTransform>
        <Ellipse Width="60" Height="60" Stroke="#313244" StrokeThickness="6" />
        <Ellipse Width="60" Height="60" Stroke="#CBA6F7" StrokeThickness="6"
                 StrokeDashArray="0.8 1.2" StrokeDashCap="Round" />
    </Grid>
</UserControl>