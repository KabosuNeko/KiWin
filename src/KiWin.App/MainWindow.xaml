<Window x:Class="KiWin.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:KiWin.App.Views"
        Title="KiWin"
        Style="{StaticResource AppWindow}"
        Width="960" Height="640"
        MinWidth="820" MinHeight="560"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <views:BrowserPage x:Name="BrowserPage" />
        <views:ReviewPage x:Name="ReviewPage" Visibility="Collapsed" />
        <views:AdvancedPage x:Name="AdvancedPage" Visibility="Collapsed" />
    </Grid>
</Window>
