<Window x:Class="KiWin.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:KiWin.App.Views"
        Title="KiWin"
        Background="{StaticResource BgBrush}"
        Width="960" Height="640"
        MinWidth="820" MinHeight="560"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource MantleBrush}"
                BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="0,0,0,1"
                Padding="16,10">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <Image x:Name="LogoIcon" Width="24" Height="24"
                               Stretch="Uniform" VerticalAlignment="Center" />
                    <TextBlock Text="KiWin" FontSize="15" FontWeight="SemiBold" Margin="10,0,0,0"
                               VerticalAlignment="Center" />
                </StackPanel>
                <Border DockPanel.Dock="Right" VerticalAlignment="Center" Cursor="Hand"
                        BorderThickness="1" CornerRadius="16" Padding="12,5"
                        MouseLeftButtonUp="TitleBarLanguage_Click">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
                            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{StaticResource SurfaceHoverBrush}" />
                                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock x:Name="TitleBarLanguage" VerticalAlignment="Center" FontSize="12.5"
                               Foreground="{StaticResource SecondaryTextBrush}" />
                </Border>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <views:BrowserPage x:Name="BrowserPage" />
            <views:ReviewPage x:Name="ReviewPage" Visibility="Collapsed" />
            <views:AdvancedPage x:Name="AdvancedPage" Visibility="Collapsed" />
            <views:LanguagePage x:Name="LanguagePage" Visibility="Collapsed" />
        </Grid>
    </Grid>
</Window>