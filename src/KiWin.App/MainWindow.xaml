<Window x:Class="KiWin.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:KiWin.App.Views"
        Title="KiWin"
        Background="{StaticResource BgBrush}"
        Width="960" Height="640"
        MinWidth="820" MinHeight="560"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                Padding="16,10">
            <DockPanel>
                <TextBlock Text="KiWin" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" />
                <TextBlock x:Name="TitleBarLanguage" HorizontalAlignment="Right"
                           VerticalAlignment="Center" Cursor="Hand" Foreground="{StaticResource SecondaryTextBrush}"
                           MouseLeftButtonUp="TitleBarLanguage_Click" />
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <views:BrowserPage x:Name="BrowserPage" />
            <views:ReviewPage x:Name="ReviewPage" Visibility="Collapsed" />
            <views:AdvancedPage x:Name="AdvancedPage" Visibility="Collapsed" />
            <views:LanguagePage x:Name="LanguagePage" Visibility="Collapsed" />
        </Grid>
    </Grid>
</Window>
