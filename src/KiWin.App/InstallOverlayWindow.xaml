<Window x:Class="KiWin.App.InstallOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:KiWin.App.Controls"
        Title="KiWin"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowState="Maximized"
        ShowInTaskbar="False"
        Topmost="True"
        AllowsTransparency="True"
        Background="Transparent"
        Cursor="None"
        Opacity="0.92"
        WindowStartupLocation="CenterScreen">
    <Border Background="#11111B">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="720">
            <TextBlock x:Name="TitleText" FontSize="34" FontWeight="SemiBold"
                       HorizontalAlignment="Center" Margin="0,0,0,10" />
            <TextBlock x:Name="GuidanceText" FontSize="15" Foreground="#A6ADC8"
                       TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center"
                       Margin="0,0,0,34" />
            <controls:SpinnerControl x:Name="Spinner" HorizontalAlignment="Center" Margin="0,0,0,26" />
            <TextBlock x:Name="StatusText" FontSize="16" HorizontalAlignment="Center"
                       TextAlignment="Center" TextWrapping="Wrap" />
        </StackPanel>
    </Border>
</Window>
