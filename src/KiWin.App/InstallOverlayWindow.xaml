<Window x:Class="KiWin.App.InstallOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:KiWin.App.Controls"
        Title="KiWin"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowState="Maximized"
        ShowInTaskbar="False"
        Topmost="True"
        AllowsTransparency="True"
        Background="Transparent"
        Cursor="None"
        Opacity="0.94"
        WindowStartupLocation="CenterScreen">
    <Border Background="{StaticResource CrustBrush}" PreviewKeyDown="Root_PreviewKeyDown">
        <Border Background="{StaticResource CardBrush}"
                BorderBrush="{StaticResource BorderStrongBrush}"
                BorderThickness="1" CornerRadius="24"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                MaxWidth="920" Padding="56,44"
                Effect="{StaticResource ShadowLevel3}">
            <StackPanel>
                <Image x:Name="LogoIcon" Width="44" Height="44"
                           Stretch="Uniform" HorizontalAlignment="Center" />
                <TextBlock x:Name="TitleText" FontSize="30" FontWeight="SemiBold"
                           HorizontalAlignment="Center" Margin="0,22,0,8" />
                <TextBlock x:Name="GuidanceText" FontSize="14" Foreground="{StaticResource SecondaryTextBrush}"
                           TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center"
                           Margin="0,0,0,28" MaxWidth="460" />
                <controls:SpinnerControl x:Name="Spinner" HorizontalAlignment="Center" Margin="0,0,0,24" />
                <TextBlock x:Name="StatusText" FontSize="15" HorizontalAlignment="Center"
                           TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,20" />
                <ListBox x:Name="LogList" MaxHeight="300" MinHeight="120"
                         Background="{StaticResource CrustBrush}"
                         BorderBrush="{StaticResource BorderStrongBrush}"
                         BorderThickness="1"
                         FontSize="11" FontFamily="Consolas"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         IsHitTestVisible="False"
                         Padding="8">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="4,1" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </StackPanel>
        </Border>
    </Border>
</Window>
